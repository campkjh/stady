# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
._*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
prisma/dev.db

# Paid downloadable assets (served via gated API, never committed)
private/

# local DB snapshots (may contain user data)
backups/

# iOS build artifacts
ios/build/
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/DerivedData/

# 모의고사 임포트 산출물(이미지/업로드기록/빌드 바이너리)
scripts/mock-exam-import/pages/
scripts/mock-exam-import/uploaded.json
scripts/mock-exam-import/manifest.json
scripts/mock-exam-import/render
scripts/mock-exam-import/pdfinfo
